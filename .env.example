# PDX-1i Configuration
#
# Every key in the first half of this file is read by pdx1.config.Settings. Values
# shown are the defaults — copy to .env and change what you need.

# Data Storage. Records and briefs are separate ground-truth streams sharing one
# SQLite database. PDX1_BRIEFS_PATH is optional — it defaults to the store path with
# a _briefs suffix (pdx1_signals.jsonl -> pdx1_signals_briefs.jsonl).
PDX1_STORE_PATH=pdx1_signals.jsonl
PDX1_DB_PATH=pdx1.db
# PDX1_BRIEFS_PATH=pdx1_signals_briefs.jsonl
PDX1_ENVIRONMENT=development

# Logging
PDX1_LOG_LEVEL=INFO

# Four-gate filter. These thresholds decide what survives scoring, so change them
# deliberately. All three are inclusive: a signal at exactly 0.5 credibility,
# exactly 50 words, or exactly 48 hours old passes.
PDX1_GATE_MIN_CREDIBILITY=0.5
PDX1_GATE_MIN_WORDS=50
PDX1_GATE_MAX_AGE_HOURS=48

# Rolling baseline window for anomaly detection
PDX1_BASELINE_WINDOW_DAYS=90

# Publication trigger. Any one condition fires a brief: accumulated weight crosses
# the threshold, an anomaly at or above the publish tier lands, or the floor cadence
# elapses. The floor exists so that silence carries no information.
PDX1_PUBLISH_ON_CHANGE=false
PDX1_PUBLISH_ANOMALY_TIER=TIER_1
PDX1_TRIGGER_WEIGHT_THRESHOLD=3.0
PDX1_TRIGGER_FLOOR_DAYS=7

# Per-adapter HTTP timeouts in seconds. Read today; used once live fetching lands.
ORESTAR_TIMEOUT=30
OLIS_TIMEOUT=30
SEI_TIMEOUT=30
WA_PDC_TIMEOUT=30
PDX911_TIMEOUT=60

# Scheduler
PDX1_CRON_HOUR=6
PDX1_CRON_MINUTE=0
PDX1_TIMEZONE=America/Los_Angeles

# Which sources the adapters read. REQUIRED, and deliberately blank here: there is no
# default and no fallback. `fixture` replays the checked-in payloads and reaches no
# network; `live` reads the real endpoints and includes the watch monitors, and needs
# the `live` extra. Leaving this unset, blank, or set to anything else refuses to
# start -- both values produce a publishable brief, so a silent default would mean an
# operator could be publishing a replay of a frozen snapshot and never see a
# difference in the output.
#
# The old PDX1_LIVE key is gone. If it is still set anywhere, startup refuses until it
# is removed, rather than ignoring it and reading the sources you did not ask for.
PDX1_SOURCE_MODE=

# Last-good payload cache. On a live fetch each adapter writes the body it received
# here; if the next fetch fails, that body is served instead so a feed outage costs
# freshness rather than the whole source. Cached payloads keep their original
# timestamps, so the velocity gate still drops records that have gone stale.
PDX1_CACHE_DIR=cache/pdx1

# Vocabulary scans. These are observation-only: they never withhold a section. When
# true (default) each section is scanned for prosecutorial vocabulary (tone) and for
# implication without a claim (hedging), and whatever matched is attached to the
# published section as an observation and stored with it. Set to false to skip the
# scans entirely, which means sections publish unannotated rather than publishing more
# freely — nothing is withheld either way. The attribution gate (every claim must cite
# a held record) is a real gate and is always enforced.
PDX1_TONE_GATE=true

# API surface (requires the `api` extra). Leaving PDX1_API_KEY blank bypasses auth
# entirely — appropriate for local use only. Set it to require an X-API-Key header.
PDX1_API_HOST=0.0.0.0
PDX1_API_PORT=8000
PDX1_API_KEY=
PDX1_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Endpoint overrides. Empty means "use the adapter's registered default". Feed URLs
# rot -- a live run on 2026-08-06 found most defaults returning 404 -- and these exist
# so correcting one costs a line here rather than a release. Run `pdx1
# --check-endpoints` to see which are currently answering.
PDX1_ORESTAR_URL=
PDX1_OLIS_URL=
PDX1_SEI_URL=
PDX1_WA_PDC_URL=
PDX1_PORTLAND_PRESS_URL=

# --- Not consumed by the engine ----------------------------------------------
# Reserved for optional written explanations. Scoring is deterministic and never
# calls out to a model; nothing reads these today.

# ANTHROPIC_API_KEY=sk-ant-...
# PDX1_LLM_MODEL=claude-haiku-4-5-20251001
